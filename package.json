{
  "name": "zuzucord",
  "version": "0.1.0",
  "description": "Unofficial Discord desktop wrapper",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.zuzify.zuzucord",
    "productName": "ZuzuCord",
    "win": {
      "target": "nsis"
    }
  }
}