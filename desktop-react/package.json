{
  "name": "zuzucord-desktop",
  "productName": "ZuzuCord",
  "version": "0.11.0",
  "description": "ZuzuCord React desktop client for Windows",
  "private": true,
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "npm run build:ui && electron .",
    "build:ui": "tsc --noEmit && vite build",
    "build:win": "npm run build:ui && node scripts/build-icon.cjs && electron-builder --win nsis zip --publish never",
    "preview": "vite preview",
    "test": "node --test electron/versions.test.cjs electron/update-policy.test.cjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "lucide-react": "0.468.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "electron-updater": "6.6.2"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "38.8.6",
    "electron-builder": "26.15.3",
    "typescript": "5.9.3",
    "sharp": "0.34.5",
    "vite": "7.3.7"
  },
  "build": {
    "appId": "com.zuzify.zuzucord.react",
    "productName": "ZuzuCord",
    "artifactName": "ZuzuCord-React-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "assets/zuzucord.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "build/installer.nsh",
      "uninstallDisplayName": "ZuzuCord",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "perMachine": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "taithedev",
        "repo": "Zuzucord",
        "releaseType": "release"
      }
    ]
  }
}
